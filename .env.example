# Copy to .env.local and fill in values. Never commit .env.local.

# Convex
# Set by `npx convex dev` on first run. Identifies the dev deployment.
CONVEX_DEPLOYMENT=
# Public URL of the Convex deployment, used by the browser client and by fetchQuery in server components.
NEXT_PUBLIC_CONVEX_URL=

# Admin gate (single operator, no user system)
# Secret entered at /admin to open a session.
ADMIN_PASSWORD=
# HMAC key for signing the admin session token. Must be set identically in the
# Next.js environment and in the Convex deployment environment, since Convex
# admin functions verify the token themselves.
ADMIN_SESSION_SECRET=

# Cloudflare Turnstile (submit form is Turnstile-ready; provider is left unwired)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
